{
  "name": "pedidosflow",
  "version": "1.0.0",
  "private": true,
  "description": "PedidosFlow: validación y conversación de pedidos personalizados de tortas (Incremento 2).",
  "type": "module",
  "scripts": {
    "dev": "tsx src/index.ts",
    "start": "tsx src/index.ts",
    "test": "tsx --test test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "build:css": "tailwindcss -i web/estilos.css -o public/estilos.css --minify",
    "verify": "npm run typecheck && npm test"
  },
  "dependencies": {
    "express": "^5.2.1"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.1.0",
    "@types/express": "^5.0.6",
    "@types/node": "^22.10.2",
    "tailwindcss": "^4.1.0",
    "tsx": "^4.20.0",
    "typescript": "^5.7.2"
  }
}
